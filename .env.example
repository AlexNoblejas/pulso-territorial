# Copiar como .env. Sólo completar el proveedor que se usará.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Límites globales locales por día UTC, compartidos por los proveedores.
# No son un tope monetario contractual. Configurar también cuotas en la cuenta.
PULSO_DAILY_TOKEN_CAP=60000
PULSO_DAILY_REQUEST_CAP=12
